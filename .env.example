# ─── Base de données (obligatoire) ────────────────────────────────────────────
# Postgres managé (Supabase / Neon / RDS…). sslmode requis sur Supabase.
DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=require

# Secret stable de signature des JWT — OBLIGATOIRE en serverless (Vercel),
# sinon chaque instance génère son secret et les sessions se cassent.
WEBUI_SECRET_KEY=change-me-long-random-string

# ─── Kilo AI Gateway (modèles de chat intégrés) ──────────────────────────────
# Clé API depuis kilo.ai → Settings → API Keys.
KILO_GATEWAY_API_KEY=your-kilo-api-key
KILO_GATEWAY_BASE_URL=https://ai-gateway.kilo.ai/api/v1

# ─── Firebase Auth (email/mot de passe) ──────────────────────────────────────
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Comptes ─────────────────────────────────────────────────────────────────
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user
DEFAULT_MODELS=dots-studio/dots-3-note-preview:free

# ─── Google OAuth (Connexion avec Google) ───────────────────────────────────
# 1. Console Firebase → Authentication → Sign-in method → Google (activer)
#    → « Web SDK configuration » : copier le Web client ID + Web client secret
# 2. Google Cloud Console → Credentials → client OAuth « Web client »
#    → URI de redirection autorisées :
#      https://nelth-ia-mg.vercel.app/oauth/google/callback   (production)
#      http://localhost:3000/oauth/google/callback            (local)
# 3. Local : renseigner .env · Production : Vercel → Settings → Environment
#    Variables (Production + Preview) puis Redeploy.
ENABLE_OAUTH=true
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optionnel : fixe l'URI de redirection si l'origine auto-détectée est incorrecte
# GOOGLE_REDIRECT_URI=https://nelth-ia-mg.vercel.app/oauth/google/callback

# ─── Google OAuth — connecteurs « @ » (Gmail / Drive / Calendar…) ───────────
# Les connecteurs du sélecteur « @ » partagent les MÊMES identifiants
# (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET) mais ont leur propre redirection :
# le client Google Cloud actuel (« ethan-nairah ») n'autorise QUE la racine
# https://nelth-ia-mg.vercel.app/ — le retour OAuth y atterrit avec
# ?code&state et public/static/loader.js le transfère vers
# /api/v1/connectors/{id}/callback (cookie d'état Path=/). Identifiants et
# redirection par défaut sont embarqués dans src/lib/apps/google-oauth-defaults.ts
# (priorité : ces variables d'env → défauts embarqués). Pour autoriser un autre
# domaine, ajoutez-le dans Google Cloud Console puis :
# GOOGLE_CONNECTOR_REDIRECT_URI=https://<domaine-autorisé>/


# ─── Topologie (auto-hébergement uniquement) ─────────────────────────────────
# True = WebSocket pur derrière un reverse proxy qui termine l'upgrade ;
# False = polling+websocket (défaut, éprouvé partout).
ENABLE_WEBSOCKET_SUPPORT=False
# APP_PORT=3000
# SOCKET_SERVICE_PORT=3001
# SOCKET_SERVICE_URL=http://127.0.0.1:3001

# ---------------------------------------------------------------------------
# Mode vocal temps réel (src/lib/voice/* + mini-services/stt-service)
# ---------------------------------------------------------------------------
# STT distant (sherpa-onnx) — mini-service local OU hôte dédié en production.
# Côté SERVICE (mini-services/stt-service/.env ou process env) :
#   STT_ENGINE=nemotron  → modèle MANDATÉ nvidia/nemotron-3.5-asr-streaming-
#                          0.6b, export OFFICIEL k2-fsa 560ms INT8
#                          (653 Mo décompressé, RAM ~1 Go, RTF ~0.9 sur 2 cœurs
#                          dédiés — prévoir ≥4 cœurs en production multi-sessions)
#   STT_ENGINE=zipformer → repli testé (EN INT8 + FR kroko, RTF 0.08–0.17)
#   STT_THREADS=n        → threads de décodage (défaut 2)
# Côté BACKEND Next.js :
STT_PROVIDER=sherpa-onnx
STT_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
STT_MODEL_PRECISION=int8
STT_REMOTE_URL=http://127.0.0.1:3031
STT_AUTH_SECRET=
# Transport vocal : WebSocket bidirectionnel (/api/voice/ws, Vercel Public Beta
# depuis 2026-06-22, Fluid Compute) avec repli automatique HTTP+SSE —
# aucun env nécessaire, le client choisit seul.
# LLM vocal mandaté — NVIDIA Nemotron via Kilo (thinking désactivé dans le code)
KILO_API_KEY=
KILO_VOICE_BASE_URL=https://api.kilo.ai/api/gateway/v1
VOICE_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# TTS : edge (node-edge-tts, primaire mandaté) | zai (repli intégré)
VOICE_TTS_PROVIDER=edge
VOICE_DEFAULT_LANGUAGE=fr
VOICE_DEFAULT_ID=fr-FR-DeniseNeural
VOICE_TTS_RATE=+0%
VOICE_TTS_PITCH=+0Hz
VOICE_MAX_SESSION_DURATION=1800
VOICE_MAX_AUDIO_SIZE=200000000
VOICE_VAD_SILENCE_MS=750
VOICE_INTERRUPTION_ENABLED=true
