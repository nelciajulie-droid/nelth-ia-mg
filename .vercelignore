# Vercel upload excludes — local-only artifacts (secrets, database, dev
# tooling). public/ is uploaded IN FULL: the compiled Open WebUI SPA under
# public/ (index.html + _app + static/loader.js overlay) IS the production
# frontend served at "/" (next.config rewrites) — excluding any of it would
# break the app.
db
data
mini-services
tests
examples
download
dev.log
agent-ctx
.env
.env.local
.vercel
*.log
